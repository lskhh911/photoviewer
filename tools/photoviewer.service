[Unit]
Description=iCloud Photo Viewer (照片库)
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/mc/photoviewer
Environment=PHOTOS_DIR=/home/mc/photoviewer/photos
ExecStart=/home/mc/.local/node/bin/node server.js --port 7788 --host 100.114.x.x
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
